# Konfigurasi perekam lalu lintas — disalin ke /etc/traffic-recorder/config.env
# Setelah mengubah berkas ini jalankan:
#   sudo systemctl restart traffic-recorder.service

# Antarmuka jaringan yang direkam (cek dengan: ip -br link)
# install.sh mengisinya otomatis dari rute default server.
INTERFACE=eth0

# Byte maksimum yang disalin per paket dari kernel. 160 byte cukup untuk
# header Ethernet + IP + TCP terpanjang. Payload di dalamnya tetap
# dikosongkan sebelum berkas meninggalkan server.
SNAPLEN=160

# Lama satu berkas rekaman, dalam detik (3600 = satu jam)
ROTATE_SECONDS=3600

# Perekaman berhenti otomatis setelah N hari (0 = berjalan terus)
DURATION_DAYS=14

# Filter BPF tambahan (opsional) untuk mengecualikan lalu lintas tertentu.
# Contoh: EXTRA_BPF="not port 3306"   atau   EXTRA_BPF="not host 10.0.0.5"
EXTRA_BPF=""

# Batas total ruang disk lokal yang boleh dipakai, dalam MB.
# Bila terlampaui (misalnya unggahan gagal berhari-hari), berkas tertua dibuang.
MAX_DISK_MB=2048

# Tujuan unggah rclone, format  nama-remote:folder
RCLONE_REMOTE=tadrive:vps-traffic

# Batas kecepatan unggah agar tidak mengganggu layanan (contoh: 512k, 1M, 2M)
UPLOAD_BWLIMIT=1M
